# TESS AI Inference Router Configuration (need.md Section 25)
# Set to true to run in local offline Demo Mode without any API keys or GPU
DEMO_MODE=true

# Server Settings
HOST=127.0.0.1
PORT=8000

# Optional Real AI Provider Configuration (OpenAI, HuggingFace, etc.)
# If left empty, the application runs seamlessly in Demo Mode
AI_PROVIDER=demo
AI_API_KEY=

# Multi-Objective Routing Weights (need.md Section 12)
QUALITY_WEIGHT=0.50
COST_WEIGHT=0.30
LATENCY_WEIGHT=0.20
